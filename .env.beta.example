# .env.beta — environment for the homelab beta deploy.
#
# Copy this file to .env.beta and fill in real values. .env.beta is
# gitignored by the project's .gitignore (which excludes .env*).
#
# Consumed by:
#   - docker-compose.yml (env_file:) → injected into the container at runtime
#   - scripts/create-neon-branch.js (only if NEON_API_TOKEN is set)

# ============================================================
# Application
# ============================================================
PORT=3001
NODE_ENV=production

# ============================================================
# Database — Neon beta branch
# ============================================================
# Either:
#  - Click "Branches → New branch" in Neon Console, name it "beta",
#    copy the connection string here, OR
#  - Fill NEON_API_TOKEN + NEON_PROJECT_ID below and run
#    `node scripts/create-neon-branch.js` to create it programmatically.
# Then put the connection string here. Must include ?sslmode=require.
DATABASE_URL=

# ============================================================
# Google OAuth — NEW dedicated client for the beta
# ============================================================
# Create at https://console.cloud.google.com/apis/credentials → "Create
# Credentials → OAuth client ID → Web application".
# See docs/DEPLOY_HOMELAB.md §4 for the exact origin + redirect URI
# values to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Public URL — Tailscale Funnel hostname (or real domain later)
# ============================================================
# Stable Funnel hostname is shown by `tailscale status` once you've
# enabled Funnel on the homelab machine, in the form:
#   <machine-name>.<tailnet-name>.ts.net
# Both vars must EXACTLY match the JS origin / redirect URI registered
# with the Google OAuth client. To swap to a real domain later, you
# only change these two values + the OAuth client config.
GOOGLE_CALLBACK_URL=https://MACHINE.TAILNET.ts.net/api/auth/google/callback
CLIENT_URL=https://MACHINE.TAILNET.ts.net

# ============================================================
# Session
# ============================================================
# At least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ============================================================
# Cloudflare R2 (placeholder)
# ============================================================
# Required env var per server/utils/env.ts but not exercised by current
# user-facing features. Any valid https URL satisfies the validator.
R2_PUBLIC_BASE_URL=https://example.invalid

# ============================================================
# Neon API — optional, only for scripts/create-neon-branch.js
# ============================================================
# Personal API token from https://console.neon.tech/app/settings/api-keys.
# Project ID is the slug in the Neon Console URL (e.g. plain-cherry-123456).
# Leave blank to skip the script and create the branch manually instead.
NEON_API_TOKEN=
NEON_PROJECT_ID=
